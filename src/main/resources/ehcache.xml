<ehcache>
    <cache
            name="linkedChatInfo"
            eternal="true"
            maxElementsInMemory="10000"
            overflowToDisk="false"
            memoryStoreEvictionPolicy="LRU">
    </cache>
    <cache
            name="adminsCache"
            eternal="true"
            maxElementsInMemory="10000"
            overflowToDisk="false"
            memoryStoreEvictionPolicy="LRU">
    </cache>
    <!-- 针对groupinfo表的缓存 -->
    <cache
            name="groupinfo"
            maxElementsInMemory="10000"
            eternal="true"
            overflowToDisk="false"
            memoryStoreEvictionPolicy="LRU"
    />
    <!-- 针对botrecord表的缓存 -->
    <cache
            name="botrecord"
            maxElementsInMemory="200000"
            eternal="true"
            overflowToDisk="false"
            memoryStoreEvictionPolicy="LRU"
    />
    <!-- 针对ai_cs_prompt表的缓存（AI客服知识条目） -->
    <cache
            name="aiCsPrompt"
            maxElementsInMemory="10000"
            eternal="true"
            overflowToDisk="false"
            memoryStoreEvictionPolicy="LRU"
    />
    <!-- 用户个人频道画像（personal_chat）：TTL 10 分钟，避免频道名变更后长期失效 -->
    <cache
            name="userChannelProfile"
            maxElementsInMemory="50000"
            eternal="false"
            timeToLiveSeconds="600"
            overflowToDisk="false"
            memoryStoreEvictionPolicy="LRU"
    />
</ehcache>